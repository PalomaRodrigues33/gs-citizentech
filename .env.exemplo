# Copie este arquivo para .env e preencha a chave. O .env não vai para o Git.
# Sem isso o assistente roda em LLM_PROVIDER=mock (regras de palavra-chave, sem modelo de linguagem).

# Groq tem camada gratuita. Pegue a chave em https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=cole_a_sua_chave_aqui
# A Groq aposenta modelos de vez em quando. Se der erro 404, veja os nomes atuais com:
#   python -m ia.smoke --modelos
GROQ_MODEL=openai/gpt-oss-120b
